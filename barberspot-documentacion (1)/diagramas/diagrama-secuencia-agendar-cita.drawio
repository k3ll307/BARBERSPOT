l id="c53" value="[ otro cliente reservó el mismo horario un instante antes ]" style="text;html=1;align=left;fontSize=11;fontStyle=2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="63.0" y="1064" width="360" height="20" as="geometry"/></mxCell><mxCell id="c54" value="ERROR: viola la restricción cita_sin_cruces" style="html=1;endArrow=open;endFill=0;dashed=1;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#b85450;fontColor=#b85450;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1580.0" y="1100" as="sourcePoint"/><mxPoint x="1425.0" y="1100" as="targetPoint"/><mxPoint x="0" y="-2" as="offset"/></mxGeometry></mxCell><mxCell id="c55" value="throw HorarioNoDisponibleException" style="html=1;endArrow=open;endFill=0;dashed=1;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#b85450;fontColor=#b85450;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1415.0" y="1130" as="sourcePoint"/><mxPoint x="930.0" y="1130" as="targetPoint"/><mxPoint x="0" y="-2" as="offset"/></mxGeometry></mxCell><mxCell id="c56" value="excepción" style="html=1;endArrow=open;endFill=0;dashed=1;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#b85450;fontColor=#b85450;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="920.0" y="1160" as="sourcePoint"/><mxPoint x="765.0" y="1160" as="targetPoint"/><mxPoint x="0" y="-2" as="offset"/></mxGeometry></mxCell><mxCell id="c57" value="409 Conflict {codigo, mensaje, traceId}&lt;br&gt;(ManejadorGlobalErrores)" style="html=1;endArrow=open;endFill=0;dashed=1;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#b85450;fontColor=#b85450;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="755.0" y="1190" as="sourcePoint"/><mxPoint x="435.0" y="1190" as="targetPoint"/><mxPoint x="0" y="-2" as="offset"/></mxGeometry></mxCell><mxCell id="c58" value="409 Conflict" style="html=1;endArrow=open;endFill=0;dashed=1;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#b85450;fontColor=#b85450;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="425.0" y="1215" as="sourcePoint"/><mxPoint x="270.0" y="1215" as="targetPoint"/><mxPoint x="0" y="-2" as="offset"/></mxGeometry></mxCell><mxCell id="c59" value="«Ese horario ya no está disponible.&lt;br&gt;Por favor elige otro.»" style="html=1;endArrow=open;endFill=0;dashed=1;fontSize=11;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#b85450;fontColor=#b85450;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="260.0" y="1243" as="sourcePoint"/><mxPoint x="100.0" y="1243" as="targetPoint"/><mxPoint x="0" y="-2" as="offset"/></mxGeometry></mxCell><mxCell id="c60" value="&lt;b&gt;Doble protección (ESC-CONF-001)&lt;/b&gt;&lt;br&gt;Paso 11: si ya hay cruce, el servicio responde 409 sin intentar el INSERT.&lt;br&gt;Paso 13: si dos clientes confirman al mismo tiempo, PostgreSQL deja pasar solo al primero." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1680.0" y="640" width="260" height="120" as="geometry"/></mxCell><mxCell id="c61" value="&lt;b&gt;Fechas en UTC&lt;/b&gt;&lt;br&gt;React envía &lt;i&gt;inicio&lt;/i&gt; en UTC (ej. 2026-11-07T14:00:00Z = 9:00 a. m. en Colombia) y convierte al mostrar." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1680.0" y="180" width="260" height="90" as="geometry"/></mxCell><mxCell id="c62" value="&lt;b&gt;Pendiente (HU-20)&lt;/b&gt;&lt;br&gt;Tras guardar, publicar un evento para enviar el correo de confirmación por NotificationGateway → Brevo." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1680.0" y="900" width="260" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>