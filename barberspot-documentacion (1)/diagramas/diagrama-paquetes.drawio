.5;fontFamily=Helvetica;" edge="1" parent="1" source="c33" target="c10"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="842" y="420"/><mxPoint x="185" y="420"/></Array></mxGeometry></mxCell><mxCell id="c50" value="«use» puerta pública&lt;br&gt;(application.port.in)" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#0050ef;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="762" y="431" width="180" height="30" as="geometry"/></mxCell><mxCell id="c51" value="«import»" style="endArrow=open;endFill=0;dashed=1;html=1;fontSize=10;strokeColor=#333333;fontFamily=Helvetica;" edge="1" parent="1" source="c30" target="c45"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c52" value="&lt;b&gt;Reglas de dependencia&lt;/b&gt;&lt;br&gt;• Dentro de cada módulo: &lt;b&gt;infrastructure → application → domain&lt;/b&gt;. Nunca al revés.&lt;br&gt;• &lt;b&gt;domain&lt;/b&gt; y &lt;b&gt;application&lt;/b&gt; son Java puro: no importan Spring ni JPA.&lt;br&gt;• Un módulo solo usa a otro a través de su &lt;b&gt;application.port.in&lt;/b&gt; (línea azul).&lt;br&gt;• * La implementación del caso de uso está en el paquete &lt;b&gt;application&lt;/b&gt; (raíz)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="860" width="760" height="80" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>