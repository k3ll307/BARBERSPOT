l><mxCell id="c73" value="throw HorarioNoDisponibleException" style="html=1;endArrow=open;endFill=0;dashed=1;fontSize=10;verticalAlign=bottom;labelBackgroundColor=none;fontFamily=Helvetica;strokeColor=#b85450;fontColor=#b85450;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1431" y="1388" as="sourcePoint"/><mxPoint x="841" y="1388" as="targetPoint"/><mxPoint x="0" y="-2" as="offset"/></mxGeometry></mxCell><mxCell id="c74" value="la excepción se propaga" style="html=1;endArrow=open;endFill=0;dashed=1;fontSize=10;verticalAlign=bottom;labelBackgroundColor=none;fontFamily=Helvetica;strokeColor=#b85450;fontColor=#b85450;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="831" y="1418" as="sourcePoint"/><mxPoint x="691" y="1418" as="targetPoint"/><mxPoint x="0" y="-2" as="offset"/></mxGeometry></mxCell><mxCell id="c75" value="reglaDeNegocio(ex)" style="html=1;endArrow=open;endFill=0;dashed=1;fontSize=10;verticalAlign=bottom;labelBackgroundColor=none;fontFamily=Helvetica;strokeColor=#b85450;fontColor=#b85450;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="691" y="1450" as="sourcePoint"/><mxPoint x="1731" y="1450" as="targetPoint"/><mxPoint x="0" y="-2" as="offset"/></mxGeometry></mxCell><mxCell id="c76" value="14'. 409 Conflict  ProblemDetail {codigo: CITA_HORARIO_NO_DISPONIBLE, detail, traceId}" style="html=1;endArrow=open;endFill=0;dashed=1;fontSize=10;verticalAlign=bottom;labelBackgroundColor=none;fontFamily=Helvetica;strokeColor=#b85450;fontColor=#b85450;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1731" y="1480" as="sourcePoint"/><mxPoint x="241" y="1480" as="targetPoint"/><mxPoint x="0" y="-2" as="offset"/></mxGeometry></mxCell><mxCell id="c77" value="«Ese horario ya no está disponible. Por favor elige otro.»" style="html=1;endArrow=open;endFill=0;dashed=1;fontSize=10;verticalAlign=bottom;labelBackgroundColor=none;fontFamily=Helvetica;strokeColor=#b85450;fontColor=#b85450;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="231" y="1512" as="sourcePoint"/><mxPoint x="86" y="1512" as="targetPoint"/><mxPoint x="0" y="-2" as="offset"/></mxGeometry></mxCell><mxCell id="c78" value="&lt;b&gt;Producción&lt;/b&gt;&lt;br&gt;Antes del paso 3 la solicitud pasa por Cloudflare WAF (ADR-016) y Kong API Gateway (ADR-018)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1831" y="380" width="270" height="80" as="geometry"/></mxCell><mxCell id="c79" value="&lt;b&gt;Paso 11&lt;/b&gt;&lt;br&gt;Si ya existe un cruce, el servicio lanza HorarioNoDisponibleException y responde 409 &lt;b&gt;sin intentar el INSERT&lt;/b&gt;." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1831" y="920" width="270" height="90" as="geometry"/></mxCell><mxCell id="c80" value="&lt;b&gt;Doble protección (ESC-CONF-001)&lt;/b&gt;&lt;br&gt;Si dos clientes confirman al mismo tiempo, la restricción de exclusión &lt;i&gt;cita_sin_cruces&lt;/i&gt; de PostgreSQL deja pasar solo al primero." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1831" y="1110" width="270" height="105" as="geometry"/></mxCell><mxCell id="c81" value="&lt;b&gt;Pendiente (HU-20)&lt;/b&gt;&lt;br&gt;Tras guardar, enviar el correo de confirmación por NotificationGateway → Brevo (ADR-006)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1831" y="1240" width="270" height="85" as="geometry"/></mxCell><mxCell id="c82" value="&lt;b&gt;Fechas&lt;/b&gt;&lt;br&gt;El backend trabaja siempre en UTC (Instant / timestamptz); el frontend convierte a la hora de Colombia solo al mostrar." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=6;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1831" y="180" width="270" height="95" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>